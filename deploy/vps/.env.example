# Copy to .env and fill in. This file lives ONLY on the VPS (not in git).
# HEADSCALE_API_KEY is created once via the headscale container:
#   docker compose -f deploy/vps/docker-compose.yml exec headscale \
#     headscale apikeys create --expiration 87600h
# then paste the returned key below.

HEADSCALE_API_KEY=__PASTE_KEY_HERE__

# First-run admin for the web UI (change this!).
WEBUI_BOOTSTRAP_ADMIN=admin:change_this_password
