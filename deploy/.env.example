# Copy to .env and fill in before `docker compose up`.
#
# Public domain (used by Caddy for TLS and by Headscale as server_url base).
DOMAIN=vpn.example.com

# Headscale API key used internally by the web backend. Generate after first
# start with:  docker compose exec headscale headscale apikeys create
# Then put the value here and `docker compose up -d webbackend` again.
HEADSCALE_API_KEY=

# Initial web-console admin account, created on first web-backend start.
# Format:  username:password   (change this!)
WEBUI_BOOTSTRAP_ADMIN=admin:change-me-strong-password
